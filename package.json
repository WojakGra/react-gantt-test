{
  "name": "@wojakgra/react-gantt-mantine",
  "version": "1.0.0",
  "description": "A customizable, high-performance React Gantt chart component built with Mantine UI",
  "packageManager": "npm@10.0.0",
  "type": "module",
  "workspaces": [
    "package"
  ],
  "keywords": [
    "react",
    "mantine",
    "gantt",
    "gantt-chart",
    "timeline",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rimraf package/dist",
    "build": "npm run clean && rollup -c rollup.config.mjs && node scripts/generate-dts.js && node scripts/prepare-css.js",
    "dev": "vite --open",
    "lint": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "prepare": "husky",
    "prettier": "prettier --write ./package/src/ ./demos/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mantine/core": ">=7.0.0",
    "@mantine/hooks": ">=7.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "homepage": "https://github.com/WojakGra/react-gantt-test#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/WojakGra/react-gantt-test.git"
  },
  "bugs": {
    "url": "https://github.com/WojakGra/react-gantt-test/issues"
  },
  "devDependencies": {
    "@mantine/core": "^7.14.4",
    "@mantine/hooks": "^7.14.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^25.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.5",
    "eslint": "9.35.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "fs-extra": "^11.3.3",
    "hash-css-selector": "^1.1.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "postcss": "^8.5.4",
    "postcss-preset-mantine": "^1.17.0",
    "prettier": "3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.8.2",
    "react-router-dom": "7.8.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.41.1",
    "rollup-plugin-banner2": "^1.3.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^6.3.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
